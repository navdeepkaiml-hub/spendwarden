# Copy this file to .env and fill it in. Never commit .env.

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# vault    = charge the buyer's saved payment token, no redirect (needs .vault_token from the vault spike)
# approval = create an order and return a link the buyer must approve (fallback)
PAYMENT_MODE=vault
VAULT_TOKEN_FILE=.vault_token

# Local database file
SPENDWARDEN_DB=spendwarden.sqlite3

# Intent verifier. gemini = ask Gemini, replay = answer only from the recorded cache (no API key needed),
# off = skip it. Set VERIFIER_RECORD=1 while rehearsing to record verdicts into the cache for replay mode.
VERIFIER_MODE=gemini
VERIFIER_RECORD=0
VERIFIER_CACHE_PATH=demo/replay/verifier_cache.json

# Gemini API key (aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Access control. Leave empty for local use. Set BOTH when you deploy, using long random strings.
# ADMIN_TOKEN protects the dashboard, approvals, policy and mandates. AGENT_TOKEN lets an agent request purchases.
ADMIN_TOKEN=
AGENT_TOKEN=

# Public demo mode (used by render.yaml): simulated payments, recorded verifier answers, one-click demo scenes.
# DEMO_MODE=1
# PAYMENT_MODE=simulated
# VERIFIER_MODE=replay
# Optional for real hosting: the saved PayPal payment token as an environment variable instead of a file.
# PAYPAL_VAULT_ID=
