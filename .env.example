# Copy this file to .env and fill it in. Never commit .env.

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Gemini API key (aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Optional: pin a model name. Leave empty and run scripts/gemini_check.py to find one that works.
GEMINI_MODEL=
